# SQL-of-Thought Configuration
# Copy this file to .env and fill in your values

# LLM Provider Configuration
# Choose: openai or anthropic
SOT_LLM_PROVIDER=openai

# API Keys (required - set one based on your provider)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Configuration
SOT_LLM_MODEL=gpt-4-turbo-preview
SOT_LLM_TEMPERATURE=0.0

# Agent Configuration
SOT_MAX_ITERATIONS=3

# Database Configuration (optional)
SOT_DB_DIALECT=sqlite
SOT_DB_DATABASE=:memory:
# SOT_DB_HOST=localhost
# SOT_DB_PORT=5432
# SOT_DB_USERNAME=user
# SOT_DB_PASSWORD=password

# Logging
SOT_VERBOSE=false
